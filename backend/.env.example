# ============================================================
# Lumen+ Backend — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================================

# ── APP ──────────────────────────────────────────────────────
ENVIRONMENT=dev                         # dev | staging | production | test
APP_NAME=Lumen+ API
APP_VERSION=0.3.0
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR
DEBUG=false

# ── SECURITY ─────────────────────────────────────────────────
SECRET_KEY=troque-em-producao

# Modo de autenticação: DEV aceita qualquer token; PROD valida com Firebase
AUTH_MODE=DEV                           # DEV | PROD

# CORS: lista separada por vírgulas
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8081

# Criptografia AES-256-GCM para CPF/RG (gerar com: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())")
ENCRYPTION_KEY=
HMAC_PEPPER=

# ── DATABASE ─────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://lumen:lumen_secret@localhost:5432/lumen_db

# Connection pool (recomendado para produção: 15/20)
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ── REDIS ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── FIREBASE ─────────────────────────────────────────────────
# Necessário apenas quando AUTH_MODE=PROD
FIREBASE_PROJECT_ID=

# ── SENTRY (opcional) ────────────────────────────────────────
SENTRY_DSN=

# ── CLOUDINARY (upload de comprovantes de retiro) ────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── FEATURE FLAGS ────────────────────────────────────────────
ENABLE_DEV_ENDPOINTS=true              # false em produção
ENABLE_AUDIT=true
ENABLE_PHONE_VERIFICATION=false
ENABLE_EMAIL_VERIFICATION=false
ENABLE_SENSITIVE_ACCESS=false
DEBUG_VERIFICATION_CODE=false          # true: código de verificação aparece na resposta

# ── WEB PUSH (VAPID) ─────────────────────────────────────────
# Gerar o par com pywebpush (ver docs/ops/push-web-activation-plan.md).
# NUNCA commitar a chave privada real — configurar direto no Railway.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_EMAIL=mailto:privacidade@lumenplus.app

# ── SENDGRID (e-mail transacional) ───────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@example.com
SENDGRID_FROM_NAME=Lumen+

# ── RATE LIMIT ───────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_VERIFICATION_PER_HOUR=5

# ── CONVITES ─────────────────────────────────────────────────
INVITE_EXPIRATION_DAYS=7
