# =============================================================================
# Lumen+ / Dokploy — NOMES das variáveis. Nenhum valor real aqui.
# =============================================================================
# Os valores entram pela UI do Dokploy (Environment), nunca neste arquivo e
# nunca no git. Este arquivo existe para que a lista seja revisável.
#
# A origem dos valores é o serviço `backend` do ambiente `production` da
# Railway, que hoje tem 31 variáveis — 11 delas injetadas pela plataforma
# (RAILWAY_*) e que NÃO devem ser copiadas.

# ── Banco (criado por este compose, não copiado da Railway) ──────────────────
# Senha NOVA, gerada na VPS. A senha do Postgres da Railway não serve para
# nada aqui: é outro servidor.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Precisa bater com as três acima. O host é o NOME DO SERVIÇO no compose,
# nunca um endereço público — é o que garante que o banco não sai da rede
# interna. `settings.py` converte postgresql:// para postgresql+psycopg://.
DATABASE_URL=postgresql://USUARIO:SENHA@postgres:5432/BANCO

# ── Identidade do ambiente ───────────────────────────────────────────────────
ENVIRONMENT=production
AUTH_MODE=PROD

# ── Segredos da aplicação — COPIAR DA RAILWAY SEM ALTERAR ────────────────────
# Trocar qualquer um destes invalida dado já gravado:
#   ENCRYPTION_KEY  decifra campos sensíveis existentes
#   HMAC_PEPPER     valida hashes já persistidos
SECRET_KEY=
ENCRYPTION_KEY=
HMAC_PEPPER=

# ── Autenticação ─────────────────────────────────────────────────────────────
# Projeto Firebase de PRODUÇÃO. O backend deriva `aud` e `iss` desta única
# variável — apontar para outro projeto faz todo token ser recusado com 401.
FIREBASE_PROJECT_ID=

# ── Rede ─────────────────────────────────────────────────────────────────────
# Lista separada por vírgula. Não usar "*".
CORS_ORIGINS=

# O host do Traefik NÃO é variável: está fixo no docker-compose.yml como
# lumenplus.andradesystems.com.br, aprovado em 06/09/2026. É um domínio nosso,
# e é isso que permite trocar de servidor por DNS sem nova build do app.

# ── Pool de conexões (paridade com a Railway) ────────────────────────────────
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ── Flags — fail-closed, mantidas como estão hoje ────────────────────────────
ENABLE_DEV_ENDPOINTS=false
DEBUG_VERIFICATION_CODE=false

# ── Web Push ─────────────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# ── E-mail ───────────────────────────────────────────────────────────────────
# Atenção: a produção Railway tem apenas FROM_EMAIL e FROM_NAME. NÃO tem
# SENDGRID_API_KEY, e `email_service.py` desiste em silêncio sem ela — ou
# seja, a produção atual não envia e-mail. Reproduzido aqui por paridade.
# Provisionar a chave é pendência PÓS-cutover, não blocker de infraestrutura.
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=

# =============================================================================
# AUSENTES DE PROPÓSITO — a produção Railway também não os tem
# =============================================================================
# Confirmado por varredura de todos os 6 serviços nos 2 ambientes, mais o
# escopo compartilhado do projeto. Acrescentar qualquer um destes agora seria
# mudar comportamento durante o cutover.
#
#   CLOUDINARY_CLOUD_NAME / CLOUDINARY_API_KEY / CLOUDINARY_API_SECRET
#     O upload de comprovante de retiro depende do Cloudinary. Como a produção
#     não tem credencial identificável, a funcionalidade pode já estar
#     indisponível hoje. Pendência FUNCIONAL a validar antes de considerar a
#     nova produção completa.
#
#   SENDGRID_API_KEY   e-mail desativado (ver acima)
#   SENTRY_DSN         observabilidade externa desativada
#   METRICS_TOKEN      sem token, /metrics responde 404 em produção
#   REDIS_URL          sem Redis, o rate limit usa o fallback em memória
#   LOG_LEVEL          default INFO
#   TRUSTED_PROXY_HOPS default 1 — correto para 1 proxy (Traefik), igual Railway
