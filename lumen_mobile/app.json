{
  "expo": {
    "name": "Lumen+",
    "slug": "lumenplus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "lumenplus",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a365d"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lumenchristi.lumenplus",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "O Lumen+ precisa acessar suas fotos para você definir a foto do seu perfil e enviar o comprovante de pagamento da inscrição em retiros.",
        "NSCameraUsageDescription": "O Lumen+ usa a câmera para você tirar a foto do seu perfil ou fotografar o comprovante de pagamento da inscrição em retiros."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a365d"
      },
      "package": "com.lumenchristi.lumenplus",
      "permissions": [
        "READ_MEDIA_IMAGES",
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Lumen+ precisa acessar suas fotos para você definir a foto do seu perfil e enviar o comprovante de pagamento da inscrição em retiros.",
          "cameraPermission": "O Lumen+ usa a câmera para você tirar a foto do seu perfil ou fotografar o comprovante de pagamento da inscrição em retiros."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "buildToolsVersion": "36.1.0"
          }
        }
      ],
      "./plugins/withReleaseSigning.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supportContactEmail": "applumenplus@gmail.com",
      "moderationContactEmail": "applumenplus@gmail.com",
      "eas": {
        "projectId": "eb8e8307-c095-4b02-a3bf-9cb10a60be65"
      }
    },
    "owner": "obra-lumen-de-evangelizacao"
  }
}
