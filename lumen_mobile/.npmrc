# jest-expo@54 (a versao do SDK 54) declara peer de react-test-renderer que o
# npm 10+ recusa em modo estrito, embora a combinacao funcione — react 19.1.0 e
# o que o proprio SDK pina.
#
# Sem este arquivo, o install local (feito com --legacy-peer-deps) e o `npm ci`
# do CI divergem, e o CI quebra no passo de dependencias. Fixar aqui mantem os
# dois ambientes identicos, que e o ponto.
legacy-peer-deps=true
