{
  "__comment": "Dashboard Lumen+ backend. Importar em Grafana (datasource Prometheus). Thresholds/eixos são VALOR INICIAL — recalibrar após a Sprint 7.",
  "title": "Lumen+ Backend",
  "schemaVersion": 39,
  "editable": true,
  "tags": ["lumen", "backend"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "title": "Request rate (por rota)",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(lumen_requests_total[5m])) by (route)",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "title": "Latência p95 (por rota)",
      "type": "timeseries",
      "datasource": "${datasource}",
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(lumen_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "p95 {{route}}"
        }
      ]
    },
    {
      "title": "Taxa de erro 5xx (%)",
      "type": "timeseries",
      "datasource": "${datasource}",
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(lumen_requests_total{status=\"5xx\"}[5m])) / clamp_min(sum(rate(lumen_requests_total[5m])), 1)",
          "legendFormat": "erro 5xx"
        }
      ]
    },
    {
      "title": "Pool de banco (checkedout / size / overflow)",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "lumen_db_pool_checkedout", "legendFormat": "checkedout" },
        { "expr": "lumen_db_pool_size", "legendFormat": "size" },
        { "expr": "lumen_db_pool_overflow", "legendFormat": "overflow" }
      ]
    },
    {
      "title": "Requests in-flight",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "lumen_requests_in_flight", "legendFormat": "in-flight" }
      ]
    },
    {
      "title": "Queries por request (taxa, por rota)",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(lumen_queries_per_request_sum[5m])) by (route) / clamp_min(sum(rate(lumen_request_duration_seconds_count[5m])) by (route), 1)",
          "legendFormat": "q/req {{route}}"
        }
      ]
    }
  ]
}
